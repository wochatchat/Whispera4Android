# === Build outputs ===
.gradle/
build/
app/build/
**/build/
captures/
.cxx/
local.properties

# === Signing / secrets ===
# Private user keystore (output of scripts/gen-keystore.sh) — NEVER commit.
release-key.jks
*.jks
keystore.properties
# Note: app/keystore/builtin-release.p12 is the *public* builtin test key and
# IS intentionally committed so anyone can build a signed release APK with zero setup.
# Do NOT add `*.p12` here or the builtin key would be ignored too.
keystore/*.jks

# === Android native libs downloaded by setup_models.sh ===
app/libs/sherpa-onnx-*.aar

# === Model files ===
# Models under app/src/main/assets/models/ can be large (>500 MB) — gitignored.
# Run ./scripts/setup_models.sh to download them locally.
app/src/main/assets/models

# === IDE ===
.idea/
*.iml
.DS_Store

# === Misc ===
*.log
*.apk
*.aab
*.pid
