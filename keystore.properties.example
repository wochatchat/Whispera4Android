# Example keystore.properties — copy to keystore.properties and fill in real values
# (or just run scripts/gen-keystore.sh which writes this file for you).
#
# This file tells Gradle which keystore + password to use for signing release APKs.
# The referenced keystore (release-key.jks) and keystore.properties itself MUST
# stay out of version control — .gitignore excludes them.

storeFile=../../release-key.jks
storePassword=changeme
keyAlias=whispera-release
keyPassword=changeme
